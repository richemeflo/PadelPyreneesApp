# API configuration
PORT=4000

# Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/padelpyrenees"

# Firebase Admin SDK credentials
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@example.iam.gserviceaccount.com"
# Keep the literal \n sequences if storing in .env. authGuard replaces them with real newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Stripe payments
STRIPE_SECRET_KEY="sk_test_yourStripeSecret"
