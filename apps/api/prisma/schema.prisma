// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * =======================
 * MODELS
 * =======================
 */

model Player {
  id           String   @id @default(cuid())
  email        String   @unique
  pseudo       String   @unique
  passwordHash String
  locale       String   @default("fr")
  lat          Float?
  lon          Float?
  streetNumber String?  @map("street_number")
  streetName   String   @default("") @map("street_name")
  city         String   @default("")
  postalCode   String   @default("") @map("postal_code")
  country      String   @default("")
  formattedAddress String? @map("formatted_address")
  homeLocation Unsupported("geography(Point, 4326)")? @map("home_location")
  elo          Int      @default(1000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Back-relations vers Pair (2 relations nomm?es L et R)
  pairsAsA Pair[] @relation("L")
  pairsAsB Pair[] @relation("R")

  // Historique Elo
  ratingHistory RatingHistory[]

  matchmakingAvailability MatchmakingAvailability[]
  scoreSubmissions        MatchScoreSubmission[]
  scoreConfirmations      MatchScoreConfirmation[]
  matchReviews            MatchReview[]
  tournamentRegistrations TournamentRegistration[]
  reservations            Reservation[]
  reservationSuggestions  ReservationSuggestion[]
  authEvents              AuthEvent[]

  @@index([elo])
  @@index([homeLocation], type: Gist)
  @@index([city])
  @@index([postalCode])
}

model Club {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  address   String
  city      String   @default("")
  postalCode String @default("") @map("postal_code")
  country   String   @default("")
  formattedAddress String? @map("formatted_address")
  location  Unsupported("geography(Point, 4326)")? @map("location")
  lat       Float
  lon       Float
  apiKind   String? // 'viapadel' | 'bruyeres' | 'manual' | ...
  apiKey    String?
  createdAt DateTime @default(now())

  // Back-relation vers Court
  courts Court[]
  reservations           Reservation[]
  reservationSuggestions ReservationSuggestion[]

  // Tournois externes cr??s par le club (optionnel)
  tournamentsExternal Tournament[] @relation("ExternalClub")

  @@unique([name, address])
  @@index([lat, lon])
  @@index([location], type: Gist)
  @@index([city])
  @@index([postalCode])
}

model Court {
  id   String @id @default(cuid())
  name String

  clubId String
  club   Club   @relation(fields: [clubId], references: [id])

  matches Match[]

  reservations           Reservation[]
  reservationSuggestions ReservationSuggestion[]

  @@unique([clubId, name]) // un court "name" unique dans un club
  @@index([clubId])
}

model Pair {
  id String @id @default(cuid())

  lId String
  rId String
  pairKey String @unique
  l   Player @relation("L", fields: [lId], references: [id])
  r   Player @relation("R", fields: [rId], references: [id])

  elo Int @default(1000)

  // Back-relations depuis Match (si on veut interroger depuis Pair)
  matchesAsA Match[] @relation("PairA")
  matchesAsB Match[] @relation("PairB")

  proposalsAsRequester MatchProposal[]         @relation("RequesterPair")
  proposalsAsOpponent  MatchProposal[]         @relation("OpponentPair")
  proposalAcceptances  MatchProposalAcceptance[]
  scoreSubmissionsAsWinner MatchScoreSubmission[]
  scoreConfirmations      MatchScoreConfirmation[]
  matchReviewsAsTarget    MatchReview[]

  @@unique([lId, rId]) // empêche de créer deux fois la même paire
  @@index([lId])
  @@index([rId])
}

model Match {
  id String @id @default(cuid())

  pairAId String
  pairBId String
  pairA   Pair   @relation("PairA", fields: [pairAId], references: [id])
  pairB   Pair   @relation("PairB", fields: [pairBId], references: [id])

  courtId String?
  court   Court?  @relation(fields: [courtId], references: [id])

  startsAt  DateTime
  score     String?
  status    String   @default("PENDING") // PENDING|CONFIRMED|DISPUTED
  createdAt DateTime @default(now())

  ratingHistory RatingHistory[]
  scoreSubmission MatchScoreSubmission?
  reviews         MatchReview[]

  @@index([pairAId])
  @@index([pairBId])
  @@index([courtId])
  @@index([startsAt])
}

model RatingHistory {
  id       String @id @default(cuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])

  matchId String
  match   Match  @relation(fields: [matchId], references: [id])

  before    Int
  after     Int
  delta     Int
  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([matchId])
}

model MatchmakingAvailability {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  start     DateTime
  end       DateTime
  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([start])
  @@index([end])
}

model MatchProposal {
  id              String   @id @default(cuid())
  requesterPairId String
  opponentPairId  String
  requesterPair   Pair     @relation("RequesterPair", fields: [requesterPairId], references: [id])
  opponentPair    Pair     @relation("OpponentPair", fields: [opponentPairId], references: [id])
  start           DateTime
  end             DateTime
  locationLat     Float
  locationLon     Float
  createdAt       DateTime @default(now())

  acceptances MatchProposalAcceptance[]

  @@index([requesterPairId])
  @@index([opponentPairId])
  @@index([start])
  @@index([end])
}

model MatchProposalAcceptance {
  id         String       @id @default(cuid())
  proposalId String
  proposal   MatchProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  pairId     String
  pair       Pair          @relation(fields: [pairId], references: [id])
  acceptedAt DateTime      @default(now())

  @@unique([proposalId, pairId])
  @@index([pairId])
}

model Tournament {
  id String @id @default(cuid())

  // kind: 'internal' | 'external'
  kind String

  // INTERNAL: cr?? par un admin (stocke son id si besoin), EXTERNAL: par un club
  createdBy String?

  // Relation vers Club si EXTERNAL
  externalClubId String?
  externalClub   Club?   @relation("ExternalClub", fields: [externalClubId], references: [id])

  name     String
  desc     String?
  levelMin Int?
  levelMax Int?
  startsAt DateTime
  endsAt   DateTime
  place    String?
  city     String   @default("")
  postalCode String @default("") @map("postal_code")
  country  String   @default("")
  formattedAddress String? @map("formatted_address")
  location Unsupported("geography(Point, 4326)")? @map("location")
  price    Int?

  registrations TournamentRegistration[]

  @@index([kind])
  @@index([externalClubId])
  @@index([startsAt])
  @@index([location], type: Gist)
  @@index([city])
  @@index([postalCode])
}

model MatchScoreSubmission {
  id           String   @id @default(cuid())
  matchId      String   @unique
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winnerPairId String
  winnerPair   Pair     @relation(fields: [winnerPairId], references: [id])
  score        String
  submittedBy  String
  submittedByPlayer Player @relation(fields: [submittedBy], references: [id])
  createdAt    DateTime @default(now())

  confirmations MatchScoreConfirmation[]

  @@index([winnerPairId])
  @@index([submittedBy])
}

model MatchScoreConfirmation {
  id           String   @id @default(cuid())
  submissionId String
  submission   MatchScoreSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id])
  pairId       String
  pair         Pair     @relation(fields: [pairId], references: [id])
  acceptedAt   DateTime @default(now())

  @@unique([submissionId, playerId])
  @@index([pairId])
  @@index([playerId])
}

model MatchReview {
  id             String   @id @default(cuid())
  matchId        String
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  targetPairId   String
  targetPair     Pair     @relation(fields: [targetPairId], references: [id])
  authorId       String
  author         Player   @relation(fields: [authorId], references: [id])
  fairPlay       Int
  skill          Int
  rematchInterest Int
  comment        String?
  createdAt      DateTime @default(now())

  @@index([matchId])
  @@index([authorId])
}

model TournamentRegistration {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  playerId     String
  player       Player   @relation(fields: [playerId], references: [id])
  createdAt    DateTime @default(now())

  @@unique([tournamentId, playerId])
  @@index([playerId])
}

model ReservationSuggestion {
  id            String   @id @default(cuid())
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  courtId       String
  court         Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  userId        String
  user          Player   @relation(fields: [userId], references: [id])
  start         DateTime
  end           DateTime
  provider      String
  estimatedPrice Int?
  currency      String?
  distanceKm    Float?
  createdAt     DateTime @default(now())
  expiresAt     DateTime?

  @@index([userId])
  @@index([createdAt])
}

model Reservation {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  courtId   String?
  court     Court?   @relation(fields: [courtId], references: [id])
  userId    String
  user      Player   @relation(fields: [userId], references: [id])
  start     DateTime
  end       DateTime
  provider  String
  createdAt DateTime @default(now())

  @@index([clubId])
  @@index([courtId])
  @@index([userId])
  @@index([start])
  @@index([end])
}

model AuthEvent {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  type      String
  path      String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([type])
  @@index([createdAt])
}

